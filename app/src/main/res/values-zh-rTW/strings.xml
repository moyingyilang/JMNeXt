    <string name="glass_high">高</string>
    <string name="glass_high_desc">真實模糊，半徑 12dp —— 最好看，低階機可能掉幀</string>
    <string name="glass_medium">中</string>
    <string name="glass_medium_desc">真實模糊，半徑 8dp —— 預設，觀感與效能折衷</string>
    <string name="glass_off">關</string>
    <string name="glass_off_desc">不做背景取樣，退回半透明填充 —— 最省電，適合低階機</string>
    <string name="motion_fast">快</string>
    <string name="motion_fast_desc">短促直接：切換乾脆、位移很小 —— 最快的節奏</string>
    <string name="motion_medium">中</string>
    <string name="motion_medium_desc">出慢入快、時長適中、位移柔和 —— 預設節奏</string>
    <string name="motion_slow">慢</string>
    <string name="motion_slow_desc">轉場更長、收尾更緩，前後層次最明顯 —— 最慢的節奏</string>

